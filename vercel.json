{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/socket-io.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/socket-io/:path*",
      "destination": "/api/socket-io"
    },
    {
      "source": "/",
      "destination": "/client/index.html"
    },
    {
      "source": "/:asset*",
      "destination": "/client/:asset*"
    }
  ]
}